# ==============================================================================
# SEPAY PROXY BACKEND - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
VERCEL_URL=localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Dùng Supavisor (Port 6543) cho Runtime Serverless
DATABASE_URL="postgresql://postgres.vwvmclbrirpbfdbrrxdn:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Dùng Direct Connection (Port 5432) cho Prisma Migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.vwvmclbrirpbfdbrrxdn.supabase.co:5432/postgres"


# ------------------------------------------------------------------------------
# 3. SECURITY & ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="[64-character-hex-string]"

# ------------------------------------------------------------------------------
# 4. UPSTASH QSTASH (Queue Infrastructure)
# ------------------------------------------------------------------------------
QSTASH_TOKEN="[qstash-token]"
QSTASH_CURRENT_SIGNING_KEY="[current-signing-key]"
QSTASH_NEXT_SIGNING_KEY="[next-signing-key]"

# ------------------------------------------------------------------------------
# 5. FIREBASE CLOUD MESSAGING (FCM)
# ------------------------------------------------------------------------------
# Mã hóa Base64 toàn bộ file service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64="[base64-encoded-json-string]"

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY (Sentry & Axiom)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://[key]@o[org].ingest.sentry.io/[project]"
AXIOM_TOKEN="xaat-[token]"
AXIOM_DATASET="sepay-proxy-logs"

# ------------------------------------------------------------------------------
# 7. JWT CONFIGURATION
# ------------------------------------------------------------------------------
JWT_SECRET="[secure-random-string]"

